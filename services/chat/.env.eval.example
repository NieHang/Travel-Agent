LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud: EU https://cloud.langfuse.com or US https://us.cloud.langfuse.com. A self-hosted URL also works.
LANGFUSE_BASE_URL=http://localhost:3000
# Google Places API (New), for eval:geocode-check and the P3 geography grader.
GOOGLE_MAPS_API_KEY=

# Model and MCP keys still come from services/chat/.env.
