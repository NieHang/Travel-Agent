{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-expect-error": "allow-with-description"
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/switch-exhaustiveness-check": "error"
  },
  "overrides": [
    {
      "files": ["src/trip/**/*.ts"],
      "excludeFiles": [
        "src/trip/turn.ts",
        "src/trip/trip.module.ts",
        "src/trip/**/*.{spec,test,e2e-spec}.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../prisma/**", "@prisma/**", "**/generated/prisma", "**/generated/prisma/**"],
                "message": "Prisma imports outside trip/turn.ts couple trip logic to persistence. Do the database I/O in src/trip/turn.ts and pass plain values in; see how turn.ts calls reduce()."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/trip/state.ts", "src/trip/commands.ts", "src/trip/view.ts", "src/trip/copy.ts", "src/trip/itinerary.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/**",
                  "@prisma/**",
                  "**/generated/prisma",
                  "**/generated/prisma/**",
                  "../prisma/**",
                  "langchain",
                  "langchain/**",
                  "@langchain/**"
                ],
                "message": "trip/state.ts, commands.ts, view.ts, copy.ts and itinerary.ts must stay pure (no Nest, Prisma or LangChain imports). Do the I/O in src/trip/turn.ts and pass plain values in; see how turn.ts calls reduce()."
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "node": true
  }
}
